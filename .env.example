
# ==== Run mode: dev | prod ====
# dev  -> bind-mounted code, hot reload (vite / tsx watch)
# prod -> built images, no bind mounts
RUN_MODE=dev
NODE_ENV=development

# ==== Host ports (host:container) ====
FRONTEND_PORT=5173
BACKEND_PORT=3001
DB_PORT=5432
ADMINER_PORT=8080

# ==== Postgres ====
POSTGRES_USER=yourDbUser
POSTGRES_PASSWORD=yourDbPassword
POSTGRES_DB=yourDbName

# ==== Backend ====
PORT=3001
DATABASE_URL=postgresql://yourDbUser:yourDbPassword@db:5432/yourDbName

CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET   # ixtiyoriy — webhook ishlatsangiz

SENTRY_DSN=yourSentryDSN

STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

IMAGEKIT_PUBLIC_KEY=public_YOUR_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=private_YOUR_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
FRONTEND_URL=http://localhost:5173
POLOR_ACCESS_TOKEN=your_polor_access_token
POLOR_WEBHOOK_SECRET=your_polor_webhook_secret
POLOR_API_BASE=https://api.polor.ai/v1
POLOR_CHECKOUT_PRODUCT_ID=your_polor_checkout_product_id

# ==== Frontend ====
VITE_API_URL=http://localhost:3001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY