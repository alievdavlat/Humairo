# ============================================================
# Single source of truth for the whole stack.
# docker-compose reads this file for:
#   1. ${VAR} interpolation inside docker-compose.yml
#   2. env_file: -> injected into the backend container
# No per-stack .env needed.
# ============================================================

# ==== Run mode: dev | prod ====
# dev  -> bind-mounted code, hot reload (vite / tsx watch)
# prod -> built images, no bind mounts
RUN_MODE=dev
NODE_ENV=development

# ==== Host ports (host:container) ====
FRONTEND_PORT=5173
BACKEND_PORT=3001
DB_PORT=5432
ADMINER_PORT=8080

# ==== Postgres ====
POSTGRES_USER=humairo
POSTGRES_PASSWORD=humairo
POSTGRES_DB=humairo_db

# ==== Backend ====
PORT=3001
# Inside the compose network Postgres is reachable at host "db"
DATABASE_URL=postgresql://humairo:humairo@db:5432/humairo_db

CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

SENTRY_DSN=

STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

IMAGEKIT_PUBLIC_KEY=public_YOUR_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=private_YOUR_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ==== Frontend ====
# Browser-facing backend URL (points at the host, not the compose network).
# Only VITE_* vars reach the frontend; secrets above never leave the backend.
VITE_API_URL=http://localhost:3001
